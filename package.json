    "bugs": {
        "url": "https://github.com/reDdboy/sitePalkino/issues"
    },
    "homepage": "https://github.com/reDdboy/sitePalkino#readme",
    "dependencies": {
        "@heroui/react": "^3.2.6",
        "@heroui/styles": "^3.2.6",
        "@internationalized/date": "^3.12.4",
        "@tailwindcss/postcss": "^4.1.18",
        "axios": "^1.7.9",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "lucide-react": "^0.469.0",
        "next": "^16.1.6",
        "next-themes": "^0.4.6",
        "react": "^19.2.4",
        "react-dom": "^19.2.7",
        "tailwindcss": "^4.1.18"
    },
    "devDependencies": {
        "@types/node": "^22.19.7",
        "@types/react": "^18.3.27",
        "@types/react-dom": "^18.3.7",
        "autoprefixer": "^10.4.23",
        "gh-pages": "^6.3.0",
        "postcss": "^8.5.6",
        "typescript": "^5.9.3"
    }
}
