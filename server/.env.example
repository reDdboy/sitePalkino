# Скопируйте в .env и заполните. Файл .env в git не коммитится.

PORT=3001
NODE_ENV=development

# Вход в админ-панель. В production (NODE_ENV=production) без этих двух значений сервер не запустится.
ADMIN_PASSWORD=change-me
# Длинная случайная строка, например: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-too

# Сайты, которым разрешено ходить в админские методы с cookie (через запятую).
# Если админка отдаётся этим же сервером на /admin, оставьте пустым.
# Публичные методы (/api/news, /api/schedule, /api/info) открыты для любых сайтов.
CORS_ORIGIN=

# Если сервер стоит за nginx/Cloudflare, поставьте 1 — тогда cookie получит флаг Secure при HTTPS.
TRUST_PROXY=

# Куда сохранять загруженные картинки и максимальный размер файла (МБ)
UPLOAD_DIR=
MAX_UPLOAD_MB=5

# Часовой пояс для понятия «сегодня» в расписании
APP_TIMEZONE=Europe/Moscow

# MySQL. Если DB_ENABLED не true, данные хранятся в памяти и пропадают при перезапуске.
DB_ENABLED=false
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=palkino_site
